# =============================================================================
# apps/mobile — Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit .env with real credentials.
# =============================================================================

# Supabase — EXPO_PUBLIC_ prefix makes these accessible in the Expo client
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App environment
EXPO_PUBLIC_APP_ENV=development

# RevenueCat — Phase 11+
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=

# AdMob — Phase 10+
# EXPO_PUBLIC_ADMOB_APP_ID_IOS=
# EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
