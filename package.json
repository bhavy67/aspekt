{
  "name": "aspekt",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@aspekt/web",
    "dev:mobile": "turbo dev --filter=@aspekt/mobile",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "upload-wallpaper": "tsx scripts/upload-wallpaper.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/sharp": "^0.32.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
