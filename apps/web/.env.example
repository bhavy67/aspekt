# =============================================================================
# apps/web — Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local with real credentials.
# =============================================================================

# Supabase — NEXT_PUBLIC_ prefix exposes these to the browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — SERVER ONLY — never use NEXT_PUBLIC_ for this
# Only set in server environments. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App environment
NEXT_PUBLIC_APP_ENV=development

# Analytics — Phase 12+
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
