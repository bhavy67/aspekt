# =============================================================================
# ASPEKT — Environment Variable Reference
# =============================================================================
# Copy the relevant section to apps/mobile/.env or apps/web/.env.local
# Never commit real credentials. This file is safe to commit.
#
# Variable naming conventions:
#   EXPO_PUBLIC_*    → safe to expose in the Expo/React Native client
#   NEXT_PUBLIC_*    → safe to expose in the Next.js browser client
#   (no prefix)      → server-only, never expose to client or mobile
# =============================================================================

# ── APP ───────────────────────────────────────────────────────────────────────
# Current environment (development | staging | production)
APP_ENV=development

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Project URL — find in Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose to client (controlled by RLS)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — SERVER ONLY — grants full database access
# Never set this on the client. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── IMAGE CDN (Phase 7+) ──────────────────────────────────────────────────────
# Cloudflare account identifier
CF_ACCOUNT_ID=

# Cloudflare R2 — object storage for wallpaper images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=    # Server-only
R2_BUCKET_NAME=

# Cloudflare Images — CDN + on-the-fly transformation
CF_IMAGES_API_TOKEN=     # Server-only

# ── REVENUECAT (Phase 11+) ────────────────────────────────────────────────────
# Mobile-only SDK keys — safe to include in app bundle
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# RevenueCat webhook secret — Server-only, for webhook signature verification
REVENUECAT_WEBHOOK_SECRET=    # Server-only

# ── ADMOB (Phase 10+) ─────────────────────────────────────────────────────────
# AdMob app IDs — required in app.config.ts for native build
ADMOB_APP_ID_IOS=
ADMOB_APP_ID_ANDROID=

# ── ANALYTICS (Phase 12+) ────────────────────────────────────────────────────
# PostHog (or chosen analytics provider)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
